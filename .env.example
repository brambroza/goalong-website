# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.

# --- Supabase (blog CMS at /admin + backup of contact messages) ---
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Contact form email (company mail server SMTP) ---
SMTP_HOST=mail.goalong.co.th
# 465 = SSL (default) · 587 = STARTTLS (then set SMTP_SECURE=false)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@goalong.co.th
SMTP_PASS=
# Sender address; most mail servers require it to match SMTP_USER
SMTP_FROM=info@goalong.co.th
# Where contact form messages are delivered
CONTACT_TO=info@goalong.co.th
